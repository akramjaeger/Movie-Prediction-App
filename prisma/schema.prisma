datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  passwordHash String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movies      Movie[]
  predictions Prediction[]

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

model Movie {
  id                String      @id @default(uuid())
  userId            String
  title             String
  description       String?
  genre             String[]
  budget            Float
  duration          Int
  releaseDate       DateTime
  language          String
  country           String
  rating            String?
  cast              String[]
  director          String?
  productionCompany String?
  actorScore        Float?
  actualRevenue     Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@index([userId])
  @@index([title])
  @@index([genre])
}

model Prediction {
  id              String         @id @default(uuid())
  userId          String
  movieId         String
  modelId         String
  result          PredictionLabel
  probability     Float?
  successScore    Int?
  confidence      Float?
  factors         Json?
  predictedAt     DateTime       @default(now())
  inputSnapshot   Json
  createdAt       DateTime       @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie    Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  model    MLModel   @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([movieId])
  @@index([predictedAt])
}

enum PredictionLabel {
  SUCCESS
  FAILURE
}

model MLModel {
  id             String     @id @default(uuid())
  name           String
  version        String     @unique
  algorithm      String
  evaluationScore Float?
  status         ModelStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())

  predictions Prediction[]

  @@index([version])
}

enum ModelStatus {
  TRAINING
  ACTIVE
  DEPRECATED
}
